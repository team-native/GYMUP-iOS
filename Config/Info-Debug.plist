	<string>운동 기록 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>루틴에 연결할 플레이리스트를 선택하기 위해 Apple Music 라이브러리를 읽습니다.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>NotoSansKR[wght].ttf</string>
		<string>GothicA1-Medium.ttf</string>
		<string>GothicA1-SemiBold.ttf</string>
		<string>GothicA1-Bold.ttf</string>
		<string>GothicA1-ExtraBold.ttf</string>
		<string>BarlowCondensed-Black.ttf</string>
		<string>BarlowCondensed-Bold.ttf</string>
		<string>BarlowCondensed-ExtraBold.ttf</string>
		<string>Archivo[wdth,wght].ttf</string>
	</array>
